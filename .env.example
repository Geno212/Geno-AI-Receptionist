PORT=3000
PUBLIC_URL=https://your-tunnel-subdomain.ngrok-free.app

# ===== LLM =====
# groq | cerebras | gemini | openrouter | cloudflare
# Benchmarked 2026-07-29: groq llama-3.3-70b = 10/10 behaviour cases, ~858ms
# median (~3x faster than the cloudflare incumbent). See bench/README.md.
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_REPLACE          # https://console.groq.com/keys (covers LLM + STT)

# Comma-separated providers to try if the primary is throttled or errors.
# Free tiers rate-limit without warning; without a fallback the visitor just
# hears silence. Strongly recommended in production.
LLM_FALLBACKS=cloudflare

# Optional alternative LLM providers
# CEREBRAS_API_KEY=                # https://cloud.cerebras.ai/
# GEMINI_API_KEY=                  # https://aistudio.google.com/apikey
# OPENROUTER_API_KEY=              # https://openrouter.ai/keys

# Cloudflare Workers AI (incumbent; useful as the LLM_FALLBACKS target)
CF_ACCOUNT_ID=your-cf-account-id
CF_API_TOKEN=cf-api-token-with-ai-run-scope
CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ===== STT =====
# Server-side Whisper via Groq's free tier (2,000 req/day, 28,800 audio-sec/day).
# Works in every browser and handles Egyptian dialect far better than the
# Chrome-only Web Speech API. Set STT_SERVER_SIDE=0 to use the browser engine.
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3
STT_SERVER_SIDE=1

# ===== TTS =====
# The only remaining paid layer. Replace with a self-hosted MIT model
# (NAMAA-Egyptian-TTS / Chatterbox) once a GPU is available.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=sk_REPLACE
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OPTIMIZE_STREAMING_LATENCY=3
ELEVENLABS_STABILITY=0.6
ELEVENLABS_SIMILARITY_BOOST=0.8
ELEVENLABS_STYLE=0.3
ELEVENLABS_USE_SPEAKER_BOOST=1

# ===== Prompt =====
# lean = trim db.json company_info (drops embedded LinkedIn work histories).
# 34% fewer tokens at the same benchmark score; matters because the prompt is
# resent every turn against Groq's 12,000 tokens/minute cap. full = send it all.
KB_MODE=lean

# ===== Behaviour =====
GREETING_ON_START=1
GREETING_TEXT="أهلاً بك في السويدي إليكتريك. أنا جينو. Welcome to El Sewedy Electric, I am Geno."
BACKCHANNEL_ENABLE=1
BACKCHANNEL_DELAY_MS=700
BACKCHANNEL_COOLDOWN_MS=2500

# Logging
LOG_TRANSCRIPTS=1
