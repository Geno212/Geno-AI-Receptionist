# ===== Ports =====
# Next.js UI on 3000; Express API/WebSocket on 3001 (npm run dev sets this).
PORT=3001
PUBLIC_URL=https://your-tunnel-subdomain.ngrok-free.app
API_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_WS_URL=ws://localhost:3001/client-ws

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Service role for Express lead/meeting writes (Dashboard → Settings → API).
# Without it, Express falls back to the publishable key (RLS must allow writes).
SUPABASE_SERVICE_ROLE_KEY=

# ===== LLM =====
# groq | cerebras | gemini | openrouter | cloudflare
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_REPLACE

LLM_FALLBACKS=cloudflare

# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ===== STT =====
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3
STT_SERVER_SIDE=1

# ===== TTS =====
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=sk_REPLACE
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OPTIMIZE_STREAMING_LATENCY=3
ELEVENLABS_STABILITY=0.6
ELEVENLABS_SIMILARITY_BOOST=0.8
ELEVENLABS_STYLE=0.3
ELEVENLABS_USE_SPEAKER_BOOST=1

# ===== Prompt =====
KB_MODE=lean

# ===== Behaviour =====
GREETING_ON_START=1
GREETING_TEXT="أهلاً بك في السويدي إليكتريك. أنا جينو. Welcome to El Sewedy Electric, I am Geno."
BACKCHANNEL_ENABLE=1
BACKCHANNEL_DELAY_MS=700
BACKCHANNEL_COOLDOWN_MS=2500

LOG_TRANSCRIPTS=1
